{
  "name": "indoors",
  "version": "0.1.0",
  "private": true,
  "description": "Indoors - um desktop/SO web em Vue 3 (Electron no PC, Capacitor no Android)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --outDir web --emptyOutDir",
    "preview": "vite preview",
    "electron:dev": "ELECTRON_DEV=1 electron .",
    "electron:start": "npm run build && electron .",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^33.0.0",
    "vite": "^5.4.0"
  }
}
